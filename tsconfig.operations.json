{
  "extends": "./.nuxt/tsconfig.server.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["scripts/relocation-dataset.ts", "scripts/local-review/bot-preview.ts", "shared/**/*.d.ts"],
  "files": [".nuxt/types/nitro-imports.d.ts"]
}
