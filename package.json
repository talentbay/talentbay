{
  "name": "talentbay",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "nuxt build",
    "build:cloudflare": "nuxt build --preset=cloudflare_module",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:cloudflare": "pnpm run build:cloudflare && pnpm dlx wrangler@4.68.0 dev",
    "deploy:cloudflare": "pnpm run build:cloudflare && pnpm dlx wrangler@4.68.0 deploy",
    "cf:types": "pnpm dlx wrangler@4.68.0 types",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:integration": "node --env-file=.env.integration node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:smoke": "node scripts/smoke-production.mjs",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:promote-admin": "node --env-file=.env scripts/promote-admin.mjs",
    "db:push": "drizzle-kit push",
    "db:seed:preview": "node --env-file=.env scripts/seed-preview.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@iconify-json/lucide": "^1.2.120",
    "@nuxt/ui": "^4.10.0",
    "@vueuse/core": "^14.4.0",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.5.29",
    "pinia": "^3.0.4",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.8"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/core": "3.29.2",
      "@tiptap/pm": "3.29.2",
      "brace-expansion@<=5.0.7": "5.0.8"
    }
  }
}
