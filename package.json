{
  "name": "talentbay",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:review": "node scripts/local-review/start.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:integration": "node --env-file=.env.integration node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:smoke": "node scripts/smoke-production.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck --build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:promote-admin": "node --env-file=.env scripts/promote-admin.mjs",
    "db:push": "drizzle-kit push",
    "db:seed:preview": "node --env-file=.env scripts/seed-preview.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@iconify-json/lucide": "^1.2.120",
    "@nuxt/ui": "^4.10.0",
    "@vueuse/core": "^14.4.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "0.5.32",
    "pinia": "^3.0.4",
    "postgres": "^3.4.9",
    "raw-body": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.8"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/core": "3.30.5",
      "@tiptap/pm": "3.30.5",
      "brace-expansion@<=5.0.11": "5.0.12",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.6"
    }
  }
}
