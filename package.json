{
  "name": "talentbay",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-production.mjs",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:promote-admin": "node --env-file=.env scripts/promote-admin.mjs",
    "db:push": "drizzle-kit push",
    "db:seed:preview": "node --env-file=.env scripts/seed-preview.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@iconify-json/lucide": "^1.2.118",
    "@nuxt/ui": "^4.10.0",
    "@vueuse/core": "^14.2.1",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.0",
    "nuxt-auth-utils": "^0.5.29",
    "pinia": "^3.0.4",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  }
}
