# PostgreSQL connection string (Neon). Use the pooled connection URL for serverless.
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Direct (non-pooled) PostgreSQL URL for Drizzle migrations.
# Falls back to DATABASE_URL for providers that do not separate pooled/direct URLs.
DATABASE_MIGRATION_URL=

# OAuth (GitHub + Google)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Telegram Mini App: server-only bot token, never expose through runtimeConfig.public.
NUXT_TELEGRAM_BOT_TOKEN=

# 32+ char secret for sealing user sessions (openssl rand -base64 32)
NUXT_SESSION_PASSWORD=
